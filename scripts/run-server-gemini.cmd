@echo off
setlocal
title ProductionLine Gemini Server
cd /d "%~dp0.."
powershell.exe -NoProfile -STA -Command " $ErrorActionPreference='Stop'; Add-Type -AssemblyName System.Security; $keyStorePath=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'ProductionLine\gemini-key.dpapi'; $keyEntropy=[Text.Encoding]::UTF8.GetBytes('ProductionLine.Gemini.v1'); function Read-SavedGeminiKey {   if (-not (Test-Path -LiteralPath $keyStorePath -PathType Leaf)) { return '' };   $plainBytes=$null;   try {     $encryptedBytes=[IO.File]::ReadAllBytes($keyStorePath);     $plainBytes=[Security.Cryptography.ProtectedData]::Unprotect($encryptedBytes,$keyEntropy,[Security.Cryptography.DataProtectionScope]::CurrentUser);     return [Text.Encoding]::UTF8.GetString($plainBytes).Trim();   } catch { Write-Host 'Saved key could not be read. Please register it again.'; return '' }   finally { if ($plainBytes) { [Array]::Clear($plainBytes,0,$plainBytes.Length) } } }; function Save-GeminiKey([string]$value) {   if ([string]::IsNullOrWhiteSpace($value) -or $value.Length -gt 512 -or $value.ToCharArray().Where({[char]::IsWhiteSpace($_)}).Count -gt 0) { throw 'Enter a valid Gemini API key without spaces.' };   $plainBytes=[Text.Encoding]::UTF8.GetBytes($value);   $tempPath=$keyStorePath+'.tmp';   try {     $encryptedBytes=[Security.Cryptography.ProtectedData]::Protect($plainBytes,$keyEntropy,[Security.Cryptography.DataProtectionScope]::CurrentUser);     [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($keyStorePath)) | Out-Null;     [IO.File]::WriteAllBytes($tempPath,$encryptedBytes);     if ([IO.File]::Exists($keyStorePath)) { [IO.File]::Replace($tempPath,$keyStorePath,[NullString]::Value) } else { [IO.File]::Move($tempPath,$keyStorePath) };   } finally {     [Array]::Clear($plainBytes,0,$plainBytes.Length);     if ([IO.File]::Exists($tempPath)) { [IO.File]::Delete($tempPath) }   } }; function Show-KeyPrompt([bool]$allowSessionOnly) {   Add-Type -AssemblyName System.Windows.Forms;   $dialog=[System.Windows.Forms.Form]::new();   $dialog.Text='Gemini API key - Save once'; $dialog.ClientSize=[System.Drawing.Size]::new(530,190);   $dialog.StartPosition='CenterScreen'; $dialog.FormBorderStyle='FixedDialog';   $dialog.MaximizeBox=$false; $dialog.MinimizeBox=$false; $dialog.TopMost=$true;   $label=[System.Windows.Forms.Label]::new(); $label.Text='Paste Gemini API key (Ctrl+V). Input is hidden.';   $label.AutoSize=$true; $label.Location=[System.Drawing.Point]::new(16,18);   $inputBox=[System.Windows.Forms.TextBox]::new(); $inputBox.Location=[System.Drawing.Point]::new(16,48);   $inputBox.Size=[System.Drawing.Size]::new(496,26); $inputBox.UseSystemPasswordChar=$true; $inputBox.ShortcutsEnabled=$true; $inputBox.MaxLength=512;   $remember=[System.Windows.Forms.CheckBox]::new(); $remember.Text='Remember on this Windows account (encrypted)';   $remember.Checked=$true; $remember.Enabled=$allowSessionOnly; $remember.Location=[System.Drawing.Point]::new(16,86); $remember.Size=[System.Drawing.Size]::new(496,24);   $note=[System.Windows.Forms.Label]::new(); $note.Text='Saved keys stay on this PC and Windows account.';   $note.AutoSize=$true; $note.Location=[System.Drawing.Point]::new(16,116);   $ok=[System.Windows.Forms.Button]::new(); $ok.Text='Save'; if ($allowSessionOnly) { $ok.Text='Connect' };   $ok.Location=[System.Drawing.Point]::new(324,148); $ok.DialogResult='OK';   $cancel=[System.Windows.Forms.Button]::new(); $cancel.Text='Cancel'; $cancel.Location=[System.Drawing.Point]::new(420,148); $cancel.DialogResult='Cancel';   $dialog.AcceptButton=$ok; $dialog.CancelButton=$cancel;   $dialog.Controls.AddRange(@($label,$inputBox,$remember,$note,$ok,$cancel)); $dialog.Add_Shown({$inputBox.Focus()});   $choice=$dialog.ShowDialog(); if ($choice -ne [System.Windows.Forms.DialogResult]::OK) { $dialog.Dispose(); exit 0 };   $value=$inputBox.Text.Trim(); $script:rememberKey=$remember.Checked; $inputBox.Clear(); $dialog.Dispose(); return $value; };  $env:DOTNET_CLI_HOME=Join-Path (Get-Location) '.dotnet-home'; $env:AI_PROVIDER='Gemini'; $env:Gemini__Enabled='true'; $geminiKeyValue=([string]$env:GEMINI_API_KEY).Trim(); if (-not $geminiKeyValue) { $geminiKeyValue=Read-SavedGeminiKey }; if ($env:PRODUCTIONLINE_GEMINI_KEY_CHECK -eq '1') {   if ($geminiKeyValue) { Write-Host 'Saved/configured Gemini key is readable.'; exit 0 };   Write-Host 'No readable Gemini key is saved.'; exit 2; }; if (-not $geminiKeyValue) {   $geminiKeyValue=Show-KeyPrompt $true;   if ($geminiKeyValue -and $script:rememberKey) { Save-GeminiKey $geminiKeyValue }; }; if (-not $geminiKeyValue) { $env:Gemini__UseSavedKey='false' }; $env:GEMINI_API_KEY=$geminiKeyValue; $project=Join-Path (Get-Location) '03_Server\ProductionLine.Server\ProductionLine.Server.csproj'; try {   & dotnet build (Join-Path (Get-Location) 'ProductionLineSystem.sln') --nologo;   if ($LASTEXITCODE -ne 0) { throw 'Build failed. Close existing production-line apps and try again.' };   & dotnet run --project $project --no-build --no-launch-profile; $result=$LASTEXITCODE; } finally { Remove-Item Env:GEMINI_API_KEY -ErrorAction SilentlyContinue; $geminiKeyValue=$null }; exit $result;"
pause
