<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>_01_AdminApp</RootNamespace>
    <!-- 화면 배율(예: 175%)에서 글자가 잘리지 않도록 100% 기준 화면을 윈도우가 키워서 보여 줌 (김하균) -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../00_Shared/ProductionLine.Shared/ProductionLine.Shared.csproj" />
    <EmbeddedResource Include="Assets\VirtualInspections\*" LogicalName="VirtualInspections.%(Filename)%(Extension)" />
    <Compile Include="..\..\00_Shared\ProductionLine.ChatUI\GroupChatPanel.cs" Link="Chat\GroupChatPanel.cs" />
    <Compile Include="..\..\00_Shared\ProductionLine.ConnectUI\*.cs" Link="Connect\%(Filename)%(Extension)" />
    <Compile Include="..\..\00_Shared\ProductionLine.ChatUI\SensorTrendPanel.cs" Link="Charts\SensorTrendPanel.cs" />
  </ItemGroup>
</Project>
