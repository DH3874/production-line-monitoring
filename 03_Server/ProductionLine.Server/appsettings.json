{
  "ServerUrl": "http://0.0.0.0:5050",
  "RequestLogRetentionDays": 7,
  "HardwareLogIntervalSeconds": 10,
  "HardwareLogRetentionDays": 7,
  "Ai": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "UseSavedKey": true,
    "Enabled": true,
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 2048,
    "RequestsPerMinute": 20,
    "RequestsPerDay": 100,
    "ThinkingLevel": "MINIMAL"
  },
  "OpenAi": {
    "Enabled": true,
    "Model": "gpt-5.4-mini",
    "TimeoutSeconds": 7,
    "MaxOutputTokens": 900,
    "RequestsPerMinute": 20,
    "RequestsPerDay": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
